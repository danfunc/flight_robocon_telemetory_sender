# ★CMake の出力ディレクトリだけを狙う。**先頭の / とと末尾の / が要る。**
#   以前は `build*` と書いていたが、macOS の大小を区別しないファイルシステムでは
#   これが **BUILD.bazel に一致**してしまい、BUILD.bazel / tools/BUILD.bazel /
#   firmware_bazel/BUILD.bazel が 3 つとも追跡されていなかった (2026-09-02 に発覚)。
#   .bazelrc がグローバルの `.*` に巻き込まれていたのと合わせて、**clone しても
#   Bazel でビルドできない状態**になっていた。
/build/
# ★場所を限定しない。.pyc には __file__ の絶対パス (= $HOME = 実名) が
#   埋まるので、公開リポジトリに入れてよいものではない。
__pycache__/
*.pyc
.vscode/rsp-last.txt

# 実行時のテレメトリ記録。走らせるたびに増える実行成果物であってソースではない。
telemetry_*.csv

# ローカル開発用設定ファイル
.bazelrc.user

# Bazel のバージョン固定。グローバル gitignore の `.*` に吸われるので明示的に戻す
# (無いと新しいクローンで Bazel 9 が選ばれ sh_binary is not defined で止まる)。
!.bazelversion
