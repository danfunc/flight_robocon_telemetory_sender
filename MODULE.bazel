# flight_robocon_telemetory_sender — Bazel ビルド (BLE core1化 + 接続フリーズ修正の
# Shizuku 移植用。既存 CMake ビルドとは並存させる。詳細は
# ~/.claude/plans/ancient-cuddling-adleman.md)。
#
# Shizuku (~/github/Shizuku) の MODULE.bazel をひな形にしている。
module(
    name = "flight_robocon_xno",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "0.0.9")
bazel_dep(name = "bazel_skylib", version = "1.6.1")
bazel_dep(name = "rules_cc", version = "0.0.10")
# ★ホスト側 (母艦) の Python を Bazel から扱うため。Bazel 8 で native の
#   py_binary/py_test が消えたので、これが無いと試験を `bazel test` に載せられない。
bazel_dep(name = "rules_python", version = "1.0.0")

# ★★interpreter を**固定する**。ホストの python3 に乗ると、マシンを変えた
#   ときや homebrew が上がったときに黙って挙動が変わる。ここは
#   「新しいチェックアウトで `bazel test //...` が通る」ことを狙っている部分。
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.11",
    is_default = True,
)
bazel_dep(name = "pico-sdk", version = "2.2.0")

bazel_dep(name = "shizuku", version = "0.1.0")

git_override(
    module_name = "shizuku",
    # ローカルのワークツリーで開発するときは .bazelrc.user に
    # common --override_module=shizuku=/path/to/Shizuku を書く。
    remote = "https://github.com/danfunc/Shizuku.git",
    commit = "38f0df5c539a3f0c23ec6559af7708043654f122",
)

bazel_dep(name = "rules_pico_flash", version = "0.1.0")

git_override(
    module_name = "rules_pico_flash",
    # ローカルのワークツリーで開発するときは .bazelrc.user に
    # common --override_module=rules_pico_flash=/path/to/rules_pico_flash を書く。
    remote = "https://github.com/danfunc/rules_pico_flash.git",
    commit = "d2616363f667947ef50359fd00a94433a0f1a87a",
)

# pico-sdk のツールチェーンは dev_dependency 登録なので、利用側が明示的に登録する。
register_toolchains(
    "@pico-sdk//bazel/toolchain:mac-aarch64-rp2040",
    "@pico-sdk//bazel/toolchain:mac-aarch64-rp2350",
    "@pico-sdk//bazel/toolchain:mac-x86_64-rp2040",
    "@pico-sdk//bazel/toolchain:mac-x86_64-rp2350",
    "@pico-sdk//bazel/toolchain:linux-x86_64-rp2040",
    "@pico-sdk//bazel/toolchain:linux-x86_64-rp2350",
    "@pico-sdk//bazel/toolchain:linux-aarch64-rp2040",
    "@pico-sdk//bazel/toolchain:linux-aarch64-rp2350",
)
